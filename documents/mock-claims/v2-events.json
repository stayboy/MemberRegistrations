  "stories": [
    {
      "id": "AD-SESSIONS",
      "as": "operator",
      "iWant": "each session row to carry its attendance, its count and the controls for both",
      "soThat": "I can record what happened without leaving the activity",
      "spec": {
        "file": "documents/specs/member-registrations-events-offerings.md",
        "anchor": "AC-3",
        "quote": "each occurrence row offers **Record headcount**"
      }
    },
    {
      "id": "EVA-LIST",
      "as": "operator",
      "iWant": "the events list to show one row per event, with each recurring event's schedule and next occurrence and every row's audience, attendance and offering summaries",
      "soThat": "I can read a date window at a glance instead of opening each event",
      "spec": {
        "file": "documents/specs/member-registrations-events-offerings.md",
        "anchor": "AC-2",
        "quote": "it shows one row per event with its occurrences in the window"
      }
    },
    {
      "id": "EVC-CREATE",
      "as": "operator",
      "iWant": "to create a standalone event from the events list",
      "soThat": "I can add a one-off conference without inventing a series",
      "spec": {
        "file": "documents/specs/member-registrations-ui.md",
        "anchor": "AC-56",
        "quote": "the request carries the FR-42a fields"
      }
    }
  ],
