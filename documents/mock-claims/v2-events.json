  "stories": [
    {
      "id": "AD-SESSIONS",
      "as": "operator",
      "iWant": "each session row to carry its attendance, its count and the controls for both",
      "soThat": "I can record what happened without leaving the activity",
      "spec": {
        "file": "documents/specs/member-registrations-events-offerings.md",
        "anchor": "AC-3",
        "quote": "each session row offers **Record headcount**"
      }
    },
    {
      "id": "EVC-CREATE",
      "as": "operator",
      "iWant": "to create a standalone event from the events list",
      "soThat": "I can add a one-off conference without inventing a series",
      "spec": {
        "file": "documents/specs/member-registrations-ui.md",
        "anchor": "AC-56",
        "quote": "the request carries the FR-42a fields and one or more sessions"
      }
    },
    {
      "id": "SYC-CREATE",
      "as": "operator",
      "iWant": "to create a presbyter-only series from the events list",
      "soThat": "I can set up a study that is hidden from member-facing surfaces",
      "spec": {
        "file": "documents/specs/member-registrations-ui.md",
        "anchor": "AC-57",
        "quote": "it offers a **Presbyter only** toggle and sends `presbyterOnly`"
      }
    }
  ],
