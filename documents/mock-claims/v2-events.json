  "stories": [
    {
      "id": "AD-SESSIONS",
      "as": "operator",
      "iWant": "each session row to carry its attendance, its count and the controls for both",
      "soThat": "I can record what happened without leaving the activity",
      "spec": {
        "file": "documents/specs/member-registrations-events-offerings.md",
        "anchor": "AC-3",
        "quote": "each occurrence row offers **Record headcount**"
      }
    },
    {
      "id": "EVA-LIST",
      "as": "operator",
      "iWant": "the events list to show one row per event, with each recurring event's schedule and next occurrence and every row's audience, attendance and offering summaries",
      "soThat": "I can read a date window at a glance instead of opening each event",
      "spec": {
        "file": "documents/specs/member-registrations-events-offerings.md",
        "anchor": "AC-2",
        "quote": "it shows one row per event with its occurrences in the window"
      }
    },
    {
      "id": "EVC-CREATE",
      "as": "operator",
      "iWant": "to create a standalone event from the events list",
      "soThat": "I can add a one-off conference without inventing a series",
      "spec": {
        "file": "documents/specs/member-registrations-ui.md",
        "anchor": "AC-56",
        "quote": "the request carries the FR-42a fields"
      }
    },
    {
      "id": "EVE-EDIT",
      "as": "an events officer",
      "iWant": "to change a recurring event’s rule while nothing has happened to its dates, and to see why I cannot once something has",
      "soThat": "I can fix a schedule without rewriting history",
      "spec": {
        "file": "documents/specs/member-registrations-ui.md",
        "anchor": "AC-66",
        "quote": "no Repeats switch is present on the edit surface"
      }
    },
    {
      "id": "EVP-PERIOD",
      "as": "an events officer",
      "iWant": "to schedule by a named period, once or monthly, and see the dates it resolves",
      "soThat": "I can set a Communion Week service without inventing an rrule",
      "spec": {
        "file": "documents/specs/member-registrations-ui.md",
        "anchor": "AC-63a",
        "quote": "the resolved dates appear only as a one-line summary plus a **Preview dates** control"
      }
    },
    {
      "id": "EVP-DETAIL",
      "as": "an events officer",
      "iWant": "the detail to show a period event as the record it stores - its own dates and rows - rather than a preview that re-resolves the rule",
      "soThat": "what I read on the page is what the event actually holds",
      "spec": {
        "file": "documents/specs/member-registrations-ui.md",
        "anchor": "AC-63a",
        "quote": "no preview is drawn on it"
      }
    }
  ],
