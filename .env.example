NODE_ENV=development
PORT=3000
API_BEARER_TOKEN=change-me-in-production
LOG_LEVEL=info

# HMAC pepper for visitor phone numbers. Production must override the default;
# rotating it changes every stored visitor hash.
VISITOR_PHONE_PEPPER=dev-only-visitor-phone-pepper

# HMAC pepper every member verification code is stored under. Production must
# override the default; rotating it invalidates only codes that are still live.
OTP_PEPPER=dev-only-otp-pepper

# The country code prefixed to a bare stored number for delivery and masking.
# The stored contact value is never rewritten. Digits only, 1-3 characters.
DEFAULT_COUNTRY_CODE=233

# WhatsApp and SMS delivery use one provider-neutral HTTP adapter that POSTs
# { to, body } as JSON with this bearer. An unset URL in production means the
# channel has no sender and the officer action answers 503 delivery_unavailable.
# Email uses RESEND_API_KEY and MAGIC_LINK_FROM, which are already required.
# WHATSAPP_SEND_URL=https://messages.example.com/whatsapp
# SMS_SEND_URL=https://messages.example.com/sms
# MESSAGE_SEND_TOKEN=provider-token

# AES-256-GCM key material for a pending USSD registration's number. It is used
# only between the registration and the officer's decision, then erased.
# Production must override the default (at least 16 characters).
REGISTRATION_PHONE_KEY=dev-only-registration-phone-key

# The public member acceptance page; the SMS carries `<base>#t=<token>`. The
# local UI serves it at /v. Production must set this explicitly.
VERIFICATION_LINK_BASE=http://localhost:5173/v

# Leave DATABASE_URL unset for zero-setup local development: the app starts an
# in-process PGlite database and migrates it automatically. Data is ephemeral.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Nalo USSD provider. The client id is not a secret; production must override
# the development default. The published message cap is 120 (allowed 1-182).
# USSD_NALO_USER_ID=NALOTest
# USSD_NALO_MAX_MSG_CHARS=120

# Production (Neon through the Vercel Marketplace) — use the *pooled* string.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
