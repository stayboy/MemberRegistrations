NODE_ENV=development
PORT=3000
API_BEARER_TOKEN=change-me-in-production
LOG_LEVEL=info

# HMAC pepper for visitor phone numbers. Production must override the default;
# rotating it changes every stored visitor hash.
VISITOR_PHONE_PEPPER=dev-only-visitor-phone-pepper

# Leave DATABASE_URL unset for zero-setup local development: the app starts an
# in-process PGlite database and migrates it automatically. Data is ephemeral.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Nalo USSD provider. The client id is not a secret; production must override
# the development default. The published message cap is 120 (allowed 1-182).
# USSD_NALO_USER_ID=NALOTest
# USSD_NALO_MAX_MSG_CHARS=120

# Production (Neon through the Vercel Marketplace) — use the *pooled* string.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
