NODE_ENV=development
PORT=3000
API_BEARER_TOKEN=change-me-in-production
LOG_LEVEL=info

# Leave DATABASE_URL unset for zero-setup local development: the app starts an
# in-process PGlite database and migrates it automatically. Data is ephemeral.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Production (Neon through the Vercel Marketplace) — use the *pooled* string.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
