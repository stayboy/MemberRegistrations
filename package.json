{
  "name": "member-registrations-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "ui"
  ],
  "description": "Member registration lookup and CRUD API (Express + TypeScript, deployable to Vercel)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:fast": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "verify:skill": "node scripts/verify-skill.mjs",
    "verify": "npm run verify:skill && npm run verify:fast && npm run build",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "ui:dev": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui run build",
    "ui:test": "npm --prefix ui run test",
    "ui:lint": "npm --prefix ui run lint",
    "ui:typecheck": "npm --prefix ui run typecheck",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "officers:add": "tsx src/authn/cli.ts add",
    "officers:deactivate": "tsx src/authn/cli.ts deactivate",
    "officers:list": "tsx src/authn/cli.ts list",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@vercel/functions": "^3.10.6",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "rrule": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
